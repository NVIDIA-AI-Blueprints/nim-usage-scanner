.env
.env.local
.env.*.local

# act secrets file (local workflow testing — contains API keys)
.secrets

# Log files
*.log
logs/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

